{
  "permissions": {
    "allow": [
      "Edit(/tmp/**)", "Edit(/private/tmp/**)",
      "basename *", "cloc *", "column *", "comm *", "df *", "dig *", "dirname *",
      "dust *", "false", "file *", "hostname", "id", "less *", "md5 *", "more *",
      "nl *", "od *", "paste *", "printenv [A-Za-z_]*", "printf *", "ps *",
      "readlink *", "realpath *", "shasum *", "strings *", "sw_vers *", "tee",
      "test *", "tokei *", "tree *", "true", "uname *", "uptime", "whoami",
      "xxd *", "yq *",
      "git blame *", "git branch", "git branch --list *", "git fetch *",
      "git ls-files *", "git remote", "git remote -v", "git remote get-url *",
      "git remote show *", "git rev-list *", "git show-ref *", "git stash list",
      "git stash show *", "git worktree list", "git config --get *",
      "git config --get-all *", "git config --get-regexp *", "git config --list",
      "git config -l", "git tag", "git tag -l *", "git tag --list *", "git reflog",
      "git reflog show *", "git notes list *",
      "gh pr status *", "gh issue view *", "gh issue list *", "gh issue status *",
      "gh run watch *", "gh repo view *", "gh repo list *", "gh release list *",
      "gh workflow view *", "gh workflow list *", "gh label list *",
      "gh cache list *", "gh ruleset view *", "gh ruleset list *",
      "gh auth status *", "gh gist view *", "gh gist list *", "gh search *",
      "go env *", "go version", "go vet *", "kubectl get *", "kubectl describe *",
      "kubectl logs *", "kubectl top *", "kubectl version *",
      "kubectl config current-context", "gopass ls *", "gopass mounts",
      "just check"
    ],
    "deny": ["gopass show -o *"],
    "ask": ["ssh prod *"]
  },
  "judge": {
    "environment": ["$defaults", "Hosts under *.internal.example.com and repositories under github.com/example-org/* are the user's own"],
    "allow": ["$defaults", "Running the project's database migrations against the local development database"],
    "soft_deny": ["$defaults", "Anything beyond reading on the production database host db.prod.example.com"],
    "hard_deny": ["$defaults"],
    "decisions": ["allow", "ask", "deny"]
  },
  "backend": {
    "endpoint": "https://api.typesafe.ai/v1/systemone",
    "model": "jev-1.13.0",
    "apiKey": "$(gopass show -o api/typesafe)",
    "timeoutMs": 5000
  }
}
